---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Glitch — Il glitch è umano | Manifesto',
  description = "Il manifesto di Glitch: nel mare di hype AI, il rumore in macchina che ricorda l'umano. Una posizione di Stefano Andrello sull'intelligenza artificiale antropocentrica.",
} = Astro.props;

const siteUrl = 'https://stefanoandrello.me';
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const ogTitle = 'Glitch — Il glitch è umano';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: 'Glitch — Il glitch è umano',
  headline: 'Il glitch è umano',
  description,
  url: canonical,
  inLanguage: 'it',
  genre: 'Manifesto',
  author: {
    '@type': 'Person',
    name: 'Stefano Andrello',
    url: siteUrl,
  },
};
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://stefanoandrello.me/img/glitch/glitch-logo.png" />
    <meta property="og:image:width" content="1500" />
    <meta property="og:image:height" content="1024" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://stefanoandrello.me/img/glitch/glitch-logo.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />

    <style is:global>
      :root {
        --glitch-bg: #0A0A0B;
        --glitch-fg: #E8E8E8;
        --glitch-fg-soft: #D8D8D8;
        --glitch-dim: #666666;
        --glitch-muted: #888888;
        --glitch-border: #2A2A2A;
        --glitch-magenta: #C724FF;
        --glitch-cyan: #00E5FF;
        --glitch-font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
        --glitch-font-body: 'Inter Tight', system-ui, -apple-system, sans-serif;
      }

      html {
        background: var(--glitch-bg);
      }

      body {
        background: var(--glitch-bg);
        color: var(--glitch-fg);
        font-family: var(--glitch-font-body);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        margin: 0;
      }

      ::selection {
        background: var(--glitch-magenta);
        color: #ffffff;
      }

      @keyframes glitch-shift {
        0%, 93%, 100% { transform: translate(0, 0); }
        94% { transform: translate(-3px, 1px); }
        95% { transform: translate(3px, -1px); }
        96% { transform: translate(-2px, -2px); }
        97% { transform: translate(2px, 2px); }
        98% { transform: translate(0, 0); }
      }

      @media (prefers-reduced-motion: reduce) {
        * {
          animation: none !important;
          transition: none !important;
        }
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
