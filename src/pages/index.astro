---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import { faqs } from '../data/faq';
import Hero from '../components/sections/Hero.astro';
import AuthorityStrip from '../components/sections/AuthorityStrip.astro';
import CostCalculator from '../components/sections/CostCalculator.astro';
import Percorso from '../components/sections/Percorso.astro';
import Compliance from '../components/sections/Compliance.astro';
import Specializzazioni from '../components/sections/Specializzazioni.astro';
import Libri from '../components/sections/Libri.astro';
import About from '../components/sections/About.astro';
import FAQ from '../components/sections/FAQ.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
import Contatti from '../components/sections/Contatti.astro';

const title = 'Stefano Andrello — AI Strategist per PMI italiane | Formazione, Consulenza, MCP';
const description =
  'AI Strategist per PMI italiane: formazione conforme EU AI Act, consulenza strategica, sviluppo di agenti AI e MCP server. Tre corsi certificati — PRIMUS, CONSILIUM, INITIUM.';
---

<BaseLayout title={title} description={description} faq={faqs}>
  <Hero />
  <AuthorityStrip />
  <CostCalculator />
  <Percorso />
  <Compliance />
  <Specializzazioni />
  <Libri />
  <About />
  <FAQ />
  <FinalCTA />
  <Contatti />
</BaseLayout>
