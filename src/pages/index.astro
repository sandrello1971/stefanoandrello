---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import { faqs } from '../data/faq';
import Hero from '../components/sections/Hero.astro';
import AuthorityStrip from '../components/sections/AuthorityStrip.astro';
import CosaFaccio from '../components/sections/CosaFaccio.astro';
import HumanInTheLoop from '../components/sections/HumanInTheLoop.astro';
import CalcolatoreTeaser from '../components/sections/CalcolatoreTeaser.astro';
import EUActSimple from '../components/sections/EUActSimple.astro';
import Libri from '../components/sections/Libri.astro';
import GlitchCallout from '../components/sections/GlitchCallout.astro';
import About from '../components/sections/About.astro';
import FAQ from '../components/sections/FAQ.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
import Contatti from '../components/sections/Contatti.astro';

const title = 'Consulente e formatore AI per PMI — Stefano Andrello';
const description =
  'Consulente e formatore AI per PMI italiane: strategia di integrazione, formazione conforme EU AI Act, agenti AI e MCP server. Tre libri sull\'AI antropocentrica.';
---

<BaseLayout title={title} description={description} faq={faqs}>
  <Hero />
  <AuthorityStrip />
  <CosaFaccio />
  <HumanInTheLoop />
  <CalcolatoreTeaser />
  <EUActSimple />
  <Libri />
  <GlitchCallout />
  <About />
  <FAQ />
  <FinalCTA />
  <Contatti />
</BaseLayout>
