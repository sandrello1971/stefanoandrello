---
export const prerender = true;

import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';

const allPosts = await getCollection('blog', ({ data }) =>
  import.meta.env.PROD ? !data.draft : true
);

const posts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const categories = Array.from(new Set(posts.map((p) => p.data.category))).sort();

const dateFormatter = new Intl.DateTimeFormat('it-IT', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const title = 'Blog — Stefano Andrello';
const description =
  'Articoli sull\'EU AI Act, l\'AI agentica, il Model Context Protocol e l\'adozione dell\'intelligenza artificiale nelle PMI italiane.';
---

<BaseLayout title={title} description={description}>
  <section class="py-20 md:py-28">
    <Container>
      <p class="text-xs uppercase tracking-widest text-stone font-medium">
        Blog
      </p>
      <h1 class="mt-6 text-5xl md:text-6xl lg:text-7xl font-heading font-semibold text-midnight leading-tight">
        Idee, metodo, chiarezza.
      </h1>
      <p class="mt-8 text-xl text-stone max-w-2xl leading-relaxed">
        Articoli su EU AI Act, AI agentica, MCP e adozione dell&apos;AI nelle PMI. Nessun hype, solo ragionamenti utili a chi deve decidere.
      </p>
    </Container>
  </section>

  <section class="pb-8">
    <Container>
      <div class="flex flex-wrap gap-2" role="list" aria-label="Filtri categoria">
        <button
          type="button"
          data-filter="all"
          class="filter-btn border border-midnight text-midnight rounded-full px-4 py-1.5 text-xs uppercase tracking-widest font-medium hover:bg-midnight hover:text-cream transition-colors data-[active=true]:bg-midnight data-[active=true]:text-cream"
          data-active="true"
        >
          Tutti
        </button>
        {categories.map((cat) => (
          <button
            type="button"
            data-filter={cat}
            class="filter-btn border border-midnight/60 text-charcoal rounded-full px-4 py-1.5 text-xs uppercase tracking-widest font-medium hover:bg-midnight hover:text-cream transition-colors data-[active=true]:bg-midnight data-[active=true]:text-cream"
          >
            {cat}
          </button>
        ))}
      </div>
    </Container>
  </section>

  <section class="pb-24">
    <Container>
      <ul class="border-t border-stone/20" id="posts-list">
        {posts.map((post) => (
          <li
            class="post-item border-b border-stone/20 py-10"
            data-category={post.data.category}
          >
            <article>
              <div class="flex flex-wrap items-center gap-4 text-xs uppercase tracking-widest text-stone">
                <time datetime={post.data.pubDate.toISOString()}>
                  {dateFormatter.format(post.data.pubDate)}
                </time>
                <span
                  class="border border-gold rounded-full px-3 py-1 text-charcoal not-italic"
                >
                  {post.data.category}
                </span>
              </div>
              <h2 class="mt-4 text-2xl md:text-3xl font-heading font-semibold text-midnight leading-tight">
                <a href={`/blog/${post.id}`} class="hover:text-gold transition-colors">
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-4 text-charcoal leading-relaxed max-w-3xl">
                {post.data.description}
              </p>
              <div class="mt-6 flex flex-wrap items-center gap-6 text-sm text-stone">
                {post.data.readingTime && (
                  <span>{post.data.readingTime} min di lettura</span>
                )}
                <a
                  href={`/blog/${post.id}`}
                  class="text-midnight font-medium hover:text-gold transition-colors"
                >
                  Leggi &rarr;
                </a>
              </div>
            </article>
          </li>
        ))}
      </ul>
      <p
        id="posts-empty"
        class="hidden mt-12 text-center text-stone"
      >
        Nessun articolo in questa categoria.
      </p>
    </Container>
  </section>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const items = document.querySelectorAll<HTMLLIElement>('.post-item');
  const empty = document.getElementById('posts-empty');

  function applyFilter(filter: string) {
    let visible = 0;
    items.forEach((item) => {
      const cat = item.getAttribute('data-category') || '';
      const show = filter === 'all' || cat === filter;
      item.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    if (empty) empty.classList.toggle('hidden', visible !== 0);

    buttons.forEach((b) => {
      const isActive = b.getAttribute('data-filter') === filter;
      b.setAttribute('data-active', isActive ? 'true' : 'false');
    });

    const url = new URL(window.location.href);
    if (filter === 'all') url.searchParams.delete('category');
    else url.searchParams.set('category', filter);
    window.history.replaceState({}, '', url.toString());
  }

  buttons.forEach((b) => {
    b.addEventListener('click', () => {
      applyFilter(b.getAttribute('data-filter') || 'all');
    });
  });

  const initial = new URLSearchParams(window.location.search).get('category');
  if (initial) applyFilter(initial);
</script>
