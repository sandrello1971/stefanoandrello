---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';

const title = 'Tre libri di Stefano Andrello sull\'intelligenza artificiale';
const description =
  'Tre libri sull\'intelligenza artificiale: Il Futuro non è scritto, L\'Intelligenza Artificiale in Pratica, Restare Umani. Per capire e governare l\'AI al lavoro.';

const author = {
  '@type': 'Person',
  name: 'Stefano Andrello',
  url: 'https://stefanoandrello.me/chi-sono',
};

const booksSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Book',
      '@id': 'https://stefanoandrello.me#book-futuro-non-scritto',
      name: 'Il Futuro non è scritto',
      alternativeHeadline: "Memorie di un'Intelligenza Artificiale",
      author,
      inLanguage: 'it',
      url: 'https://www.amazon.it/dp/B0F8K8367C',
      identifier: { '@type': 'PropertyValue', propertyID: 'ASIN', value: 'B0F8K8367C' },
    },
    {
      '@type': 'Book',
      '@id': 'https://stefanoandrello.me#book-ia-in-pratica',
      name: "L'Intelligenza Artificiale in Pratica",
      alternativeHeadline: 'Guida critica per educatori e professionisti',
      author,
      datePublished: '2025-12-04',
      inLanguage: 'it',
      numberOfPages: 206,
      url: 'https://www.amazon.it/dp/B0G58CYJ4V',
      identifier: { '@type': 'PropertyValue', propertyID: 'ASIN', value: 'B0G58CYJ4V' },
    },
    {
      '@type': 'Book',
      '@id': 'https://stefanoandrello.me#book-restare-umani',
      name: "Restare Umani: Guida all'intelligenza artificiale per chi non vuole smettere di pensare",
      alternativeHeadline: "Manifesto antropocentrico sull'intelligenza artificiale",
      author,
      datePublished: '2026-04-28',
      inLanguage: 'it',
      numberOfPages: 199,
      isbn: '9798259248908',
      url: 'https://www.amazon.it/dp/B0GYX3JK3Z',
      identifier: [
        { '@type': 'PropertyValue', propertyID: 'ISBN', value: '9798259248908' },
        { '@type': 'PropertyValue', propertyID: 'ASIN', value: 'B0GYX3JK3Z' },
      ],
    },
  ],
};
---

<BaseLayout title={title} description={description}>
  <section class="py-20 md:py-28">
    <Container>
      <nav class="text-xs text-stone mb-8" aria-label="Breadcrumb">
        <a href="/" class="hover:text-midnight transition-colors">Home</a>
        <span class="mx-2">/</span>
        <span class="text-charcoal">Libri</span>
      </nav>
      <p class="text-xs uppercase tracking-widest text-stone font-medium">
        I libri
      </p>
      <h1 class="mt-4 text-4xl md:text-5xl lg:text-6xl font-heading font-semibold text-midnight leading-[1.1]">
        Tre libri, una traiettoria.
      </h1>
      <p class="mt-6 text-xl italic text-stone leading-relaxed max-w-2xl">
        Tre tappe per capire &mdash; e governare &mdash; l&apos;intelligenza artificiale nel lavoro umano.
      </p>
    </Container>
  </section>

  <section class="pb-12">
    <Container>
      <div class="max-w-prose">
        <p class="text-lg text-charcoal leading-relaxed">
          Ho scritto questi tre libri nell&apos;arco di un anno e mezzo, e non per caso seguono un ordine preciso. Ognuno risponde a una domanda diversa che le persone mi pongono quando incontrano l&apos;AI per la prima volta. Si possono leggere indipendentemente. Letti in ordine, raccontano insieme la traiettoria di chi ha scelto di non lasciare l&apos;AI a se stessa.
        </p>
      </div>
    </Container>
  </section>

  <!-- LIBRO 1 — Il Futuro non è scritto -->
  <section class="py-20 border-t border-stone/20">
    <Container>
      <div class="grid grid-cols-1 md:grid-cols-5 gap-12 md:gap-16 items-start">
        <div class="md:col-span-2">
          <img
            src="/img/libri/futuro-non-scritto.jpg"
            alt="Copertina di Il Futuro non è scritto, di Stefano Andrello"
            width="640"
            height="960"
            loading="eager"
            class="rounded-lg shadow-2xl max-w-[320px] w-full mx-auto"
          />
        </div>
        <div class="md:col-span-3">
          <p class="text-xs uppercase tracking-widest text-stone font-medium">
            Primo volume &middot; 2024
          </p>
          <h2 class="mt-4 text-3xl md:text-4xl font-heading font-semibold text-midnight leading-tight">
            Il Futuro non è scritto.
          </h2>
          <p class="mt-3 italic text-stone text-lg">
            Cos&apos;è l&apos;AI?
          </p>
          <p class="mt-5 text-charcoal leading-relaxed font-medium">
            Un viaggio narrativo dentro la mente di un&apos;intelligenza artificiale. La storia, le capacità, i limiti &mdash; raccontati in prima persona dall&apos;AI stessa.
          </p>

          <div class="mt-8 space-y-5 text-charcoal leading-relaxed">
            <p>
              Un viaggio narrativo nel mondo dell&apos;AI raccontato in prima persona. L&apos;AI parla di sé: chi è, da dove viene, dove sta andando.
            </p>
            <p>
              Dalle origini del Test di Turing al Deep Learning, dall&apos;Inverno dell&apos;AI al boom dei Large Language Model, una voce non umana racconta la propria storia, le proprie capacità e i propri limiti &mdash; senza falsi miti né apocalittiche promesse.
            </p>
            <p>
              Per chi vuole capire l&apos;intelligenza artificiale dall&apos;interno, prima di valutare.
            </p>
          </div>

          <div class="mt-10">
            <a
              href="https://www.amazon.it/dp/B0F8K8367C"
              target="_blank"
              rel="noopener"
              class="inline-flex items-center justify-center bg-gold text-midnight rounded-full px-8 py-3 font-medium hover:scale-[1.02] hover:bg-gold/90 transition-all"
            >
              Acquista su Amazon &rarr;
            </a>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- LIBRO 2 — L'Intelligenza Artificiale in Pratica -->
  <section class="py-20 bg-sand border-t border-stone/20">
    <Container>
      <div class="grid grid-cols-1 md:grid-cols-5 gap-12 md:gap-16 items-start">
        <div class="md:col-span-2">
          <img
            src="/img/libri/ia-in-pratica.jpg"
            alt="Copertina di L'Intelligenza Artificiale in Pratica - Guida critica per educatori e professionisti, di Stefano Andrello"
            width="640"
            height="960"
            loading="lazy"
            class="rounded-lg shadow-2xl max-w-[320px] w-full mx-auto"
          />
        </div>
        <div class="md:col-span-3">
          <p class="text-xs uppercase tracking-widest text-stone font-medium">
            Secondo volume &middot; Dicembre 2025 &middot; 206 pagine
          </p>
          <h2 class="mt-4 text-3xl md:text-4xl font-heading font-semibold text-midnight leading-tight">
            L&apos;Intelligenza Artificiale in Pratica.
          </h2>
          <p class="mt-3 italic text-stone text-lg">
            Come si usa bene?
          </p>
          <p class="mt-5 text-charcoal leading-relaxed font-medium">
            Il manuale operativo. Pedagogia critica per educatori, formatori, professionisti che devono integrare l&apos;AI nei processi reali, oggi. Senza magia, con metodo.
          </p>

          <div class="mt-8 space-y-5 text-charcoal leading-relaxed">
            <p>
              Dall&apos;autore di <em>Il Futuro non è scritto</em>, la guida operativa per passare dalla teoria alla pratica nell&apos;era dell&apos;Intelligenza Artificiale.
            </p>
            <p>
              Alle 7:12 un algoritmo decide la tua strada per il lavoro. Alle 9:30 un software seleziona il candidato ideale, scartando il tuo curriculum. L&apos;Intelligenza Artificiale non è più il futuro: è il collega silenzioso che siede già nei nostri uffici, nelle aule scolastiche e nei consigli di amministrazione.
            </p>
            <p>
              La domanda non è più <em>se</em> usarla, ma <em>come</em> governarla senza farsi sostituire.
            </p>
            <p>
              Non un saggio filosofico, ma un manuale operativo di &laquo;pedagogia critica&raquo; per chi deve gestire la transizione digitale oggi: educatori, formatori, professionisti.
            </p>
          </div>

          <dl class="mt-10 grid grid-cols-2 gap-x-6 gap-y-4 text-sm">
            <div>
              <dt class="text-xs uppercase tracking-widest text-stone font-medium">Pagine</dt>
              <dd class="mt-1 text-charcoal">206</dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-widest text-stone font-medium">Lingua</dt>
              <dd class="mt-1 text-charcoal">Italiano</dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-widest text-stone font-medium">Pubblicato</dt>
              <dd class="mt-1 text-charcoal">4 dicembre 2025</dd>
            </div>
          </dl>

          <div class="mt-10 flex flex-col sm:flex-row flex-wrap gap-4">
            <a
              href="https://www.amazon.it/dp/B0G58CYJ4V"
              target="_blank"
              rel="noopener"
              class="inline-flex items-center justify-center bg-gold text-midnight rounded-full px-8 py-3 font-medium hover:scale-[1.02] hover:bg-gold/90 transition-all"
            >
              Acquista su Amazon &mdash; 15,60 &euro; &rarr;
            </a>
            <a
              href="https://www.amazon.it/dp/B0G58CYJ4V"
              target="_blank"
              rel="noopener"
              class="inline-flex items-center justify-center border border-midnight text-midnight rounded-full px-8 py-3 font-medium hover:bg-midnight hover:text-cream transition-colors"
            >
              Versione Kindle &mdash; 7,99 &euro; &rarr;
            </a>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- LIBRO 3 — Restare Umani -->
  <section class="py-20 border-t border-stone/20">
    <Container>
      <div class="grid grid-cols-1 md:grid-cols-5 gap-12 md:gap-16 items-start">
        <div class="md:col-span-2">
          <img
            src="/img/libri/restare-umani.png"
            alt="Copertina di Restare Umani - Guida all'intelligenza artificiale per chi non vuole smettere di pensare, di Stefano Andrello"
            width="640"
            height="960"
            loading="lazy"
            class="rounded-lg shadow-2xl max-w-[320px] w-full mx-auto"
          />
        </div>
        <div class="md:col-span-3">
          <p class="text-xs uppercase tracking-widest text-stone font-medium">
            Terzo volume &middot; Aprile 2026 &middot; 199 pagine
          </p>
          <h2 class="mt-4 text-3xl md:text-4xl font-heading font-semibold text-midnight leading-tight">
            Restare Umani.
          </h2>
          <p class="mt-3 italic text-stone text-lg">
            Perché continuare a pensare?
          </p>
          <p class="mt-5 text-charcoal leading-relaxed font-medium">
            Il manifesto antropocentrico. Una guida per chi non vuole smettere di esercitare il proprio giudizio anche quando l&apos;algoritmo offre la scorciatoia. Il libro più filosofico dei tre, e il più necessario.
          </p>

          <div class="mt-8 space-y-5 text-charcoal leading-relaxed">
            <p>
              Sono le 7:12. Il telefono di Marta si accende e le mostra esattamente quello che le serve: la temperatura, il traffico, tre messaggi importanti. Marta non si chiede come faccia il telefono a sapere tutto questo. Non se lo chiede mai.
            </p>
            <p>
              Eppure ognuno di noi, ogni mattina, vive scene come questa. Algoritmi che sanno a che ora ci svegliamo, che cosa ci farà arrabbiare scrollando, quali notizie ci convinceranno a votare. Sistemi che decidono se la nostra richiesta di mutuo passa, se il nostro CV arriva mai a un essere umano, se i nostri figli vedono contenuti adatti alla loro età.
            </p>
            <p>
              Questo libro racconta come funzionano davvero quelle macchine, senza chiederti di diventare un tecnico. Lo fa attraverso le storie di tre persone &mdash; un&apos;impiegata, uno studente, una funzionaria pubblica &mdash; e attraverso i casi che ci riguardano da vicino: dal blocco di ChatGPT da parte del Garante italiano alla sentenza di Bologna sui rider di Deliveroo, dall&apos;algoritmo della Buona Scuola alla tragedia che ha portato il Garante a intervenire sui feed di TikTok.
            </p>
            <p>
              Non troverai istruzioni. Troverai un punto di vista nuovo su qualcosa che usi tutti i giorni senza guardarlo davvero. E, alla fine, qualche scelta concreta da fare.
            </p>
          </div>

          <blockquote class="mt-10 max-w-prose border-l-4 border-gold pl-6">
            <p class="font-heading italic text-2xl text-midnight leading-snug">
              &laquo;Restare umani non significa rifiutare le macchine. Significa scegliere come usarle, prima che siano loro a usare te.&raquo;
            </p>
            <footer class="mt-3 text-xs uppercase tracking-widest text-stone">
              dall&apos;introduzione
            </footer>
          </blockquote>

          <dl class="mt-10 grid grid-cols-2 gap-x-6 gap-y-4 text-sm">
            <div>
              <dt class="text-xs uppercase tracking-widest text-stone font-medium">Pagine</dt>
              <dd class="mt-1 text-charcoal">199</dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-widest text-stone font-medium">Lingua</dt>
              <dd class="mt-1 text-charcoal">Italiano</dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-widest text-stone font-medium">ISBN</dt>
              <dd class="mt-1 text-charcoal">979-8259248908</dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-widest text-stone font-medium">Pubblicato</dt>
              <dd class="mt-1 text-charcoal">28 aprile 2026</dd>
            </div>
          </dl>

          <div class="mt-10 flex flex-col sm:flex-row flex-wrap gap-4">
            <a
              href="https://www.amazon.it/dp/B0GYX3JK3Z"
              target="_blank"
              rel="noopener"
              class="inline-flex items-center justify-center bg-gold text-midnight rounded-full px-8 py-3 font-medium hover:scale-[1.02] hover:bg-gold/90 transition-all"
            >
              Acquista su Amazon &mdash; 15,60 &euro; &rarr;
            </a>
            <a
              href="https://www.amazon.it/dp/B0GYX3JK3Z"
              target="_blank"
              rel="noopener"
              class="inline-flex items-center justify-center border border-midnight text-midnight rounded-full px-8 py-3 font-medium hover:bg-midnight hover:text-cream transition-colors"
            >
              Versione Kindle &mdash; 12,99 &euro; &rarr;
            </a>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Sezione finale -->
  <section class="py-16 bg-sand border-t border-stone/20">
    <Container>
      <div class="max-w-2xl mx-auto text-center">
        <h3 class="text-2xl md:text-3xl font-heading font-semibold text-midnight leading-tight">
          Stefano scrive di intelligenza artificiale dal 2024.
        </h3>
        <p class="mt-6 text-lg text-charcoal leading-relaxed">
          I suoi libri sono usati come testi di riferimento in corsi di formazione aziendale e in alcuni istituti scolastici italiani.
        </p>
        <a
          href="/contatti"
          class="mt-10 inline-flex items-center justify-center bg-gold text-midnight rounded-full px-8 py-3 font-medium hover:scale-[1.02] hover:bg-gold/90 transition-all"
        >
          Parliamo di formazione &rarr;
        </a>
      </div>
    </Container>
  </section>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(booksSchema)} />
</BaseLayout>
