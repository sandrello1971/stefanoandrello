---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';

const title = 'Contatti — Stefano Andrello | AI Strategist per PMI italiane';
const description =
  'Scrivimi per parlare di formazione AI, consulenza strategica, sviluppo MCP, AI agentica. Risposta entro 24h lavorative. info@stefanoandrello.me — Corsico (MI).';
---

<BaseLayout title={title} description={description}>
  <section class="py-20 md:py-28">
    <Container>
      <nav class="text-xs text-stone mb-8" aria-label="Breadcrumb">
        <a href="/" class="hover:text-midnight transition-colors">Home</a>
        <span class="mx-2">/</span>
        <span class="text-charcoal">Contatti</span>
      </nav>
      <p class="text-xs uppercase tracking-widest text-stone font-medium">
        Contatti
      </p>
      <h1 class="mt-4 text-4xl md:text-5xl lg:text-6xl font-heading font-semibold text-midnight leading-[1.1]">
        Parliamo del tuo progetto.
      </h1>
      <p class="mt-6 text-xl text-stone leading-relaxed max-w-2xl">
        Scrivimi per formazione, consulenza strategica, sviluppo di agenti AI o MCP. Rispondo entro 24 ore lavorative.
      </p>
    </Container>
  </section>

  <section class="pb-24">
    <Container>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16">
        <div>
          <dl class="space-y-6 text-charcoal">
            <div>
              <dt class="text-xs uppercase tracking-widest text-stone font-medium">Email</dt>
              <dd class="mt-2 text-lg">
                <a href="mailto:info@stefanoandrello.me" class="hover:text-gold/80 transition-colors">
                  info@stefanoandrello.me
                </a>
              </dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-widest text-stone font-medium">Telefono</dt>
              <dd class="mt-2 text-lg">
                <a href="tel:+393476859801" class="hover:text-gold/80 transition-colors">
                  +39 347 685 9801
                </a>
              </dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-widest text-stone font-medium">LinkedIn</dt>
              <dd class="mt-2 text-lg">
                <a
                  href="https://www.linkedin.com/in/sandrello/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-gold/80 transition-colors"
                >
                  /in/sandrello &rarr;
                </a>
              </dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-widest text-stone font-medium">Facebook</dt>
              <dd class="mt-2 text-lg">
                <a
                  href="https://www.facebook.com/Stefano.Andrello.Noscite"
                  target="_blank"
                  rel="noopener"
                  aria-label="Facebook"
                  class="hover:text-gold/80 transition-colors"
                >
                  Facebook &rarr;
                </a>
              </dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-widest text-stone font-medium">Instagram</dt>
              <dd class="mt-2 text-lg">
                <a
                  href="https://www.instagram.com/stefano_andrello/"
                  target="_blank"
                  rel="noopener"
                  aria-label="Instagram"
                  class="hover:text-gold/80 transition-colors"
                >
                  Instagram &rarr;
                </a>
              </dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-widest text-stone font-medium">Ragione sociale</dt>
              <dd class="mt-2 text-lg">Noscite S.r.l.s. &mdash; P.IVA 14209320960 &mdash; Corsico (MI)</dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-widest text-stone font-medium">Tempi di risposta</dt>
              <dd class="mt-2 text-lg">Risposta entro 24h lavorative</dd>
            </div>
          </dl>

          <a
            href="https://wa.me/393476859801"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-10 inline-flex items-center justify-center bg-[#25D366] text-white rounded-full px-6 py-3 font-medium hover:brightness-105 transition"
          >
            Scrivimi su WhatsApp
          </a>
        </div>

        <form id="contact-form" class="space-y-6" novalidate>
          <div aria-hidden="true" style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden;">
            <label>
              Website
              <input type="text" name="website" tabindex="-1" autocomplete="off" />
            </label>
          </div>

          <label class="block">
            <span class="text-xs uppercase tracking-widest text-stone font-medium">Nome</span>
            <input
              type="text"
              name="nome"
              required
              class="mt-2 w-full bg-transparent border-0 border-b border-stone/40 pb-2 text-lg text-charcoal focus:outline-none focus:border-gold"
            />
          </label>

          <label class="block">
            <span class="text-xs uppercase tracking-widest text-stone font-medium">Email</span>
            <input
              type="email"
              name="email"
              required
              class="mt-2 w-full bg-transparent border-0 border-b border-stone/40 pb-2 text-lg text-charcoal focus:outline-none focus:border-gold"
            />
          </label>

          <label class="block">
            <span class="text-xs uppercase tracking-widest text-stone font-medium">
              Qual &egrave; oggi il tuo problema principale con l&apos;AI in azienda?
            </span>
            <textarea
              name="problema"
              rows="1"
              class="mt-2 w-full bg-transparent border-0 border-b border-stone/40 pb-2 text-lg text-charcoal focus:outline-none focus:border-gold resize-none"
            ></textarea>
          </label>

          <label class="block">
            <span class="text-xs uppercase tracking-widest text-stone font-medium">Tipo di richiesta</span>
            <select
              name="tipo"
              id="contact-tipo"
              class="mt-2 w-full bg-transparent border-0 border-b border-stone/40 pb-2 text-lg text-charcoal focus:outline-none focus:border-gold"
            >
              <option value="primus">Formazione PRIMUS (4h)</option>
              <option value="consilium">Formazione CONSILIUM (7h)</option>
              <option value="initium">Formazione INITIUM (20h)</option>
              <option value="consulenza-agentica">Consulenza AI agentica</option>
              <option value="mcp">Sviluppo MCP server</option>
              <option value="speaking">Speaking / eventi</option>
              <option value="altro">Altro</option>
            </select>
          </label>

          <label class="block">
            <span class="text-xs uppercase tracking-widest text-stone font-medium">Messaggio</span>
            <textarea
              name="messaggio"
              rows="5"
              required
              class="mt-2 w-full bg-transparent border border-stone/40 rounded-lg p-3 text-base text-charcoal focus:outline-none focus:border-gold resize-y"
            ></textarea>
          </label>

          <div class="flex items-center gap-4">
            <button
              id="contact-submit"
              type="submit"
              class="inline-flex items-center justify-center bg-gold text-midnight rounded-full px-8 py-3 font-medium hover:scale-[1.02] hover:bg-gold/90 transition-all disabled:opacity-60 disabled:cursor-not-allowed disabled:hover:scale-100"
            >
              Invia messaggio
            </button>
            <span id="contact-status" class="text-sm text-stone" aria-live="polite"></span>
          </div>

          <p class="text-xs text-stone mt-6">
            I tuoi dati sono trattati nel rispetto del GDPR. Vedi <a href="/privacy" class="underline decoration-gold underline-offset-2 hover:text-midnight">privacy policy</a> &rarr;.
          </p>
        </form>
      </div>
    </Container>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const select = document.getElementById('contact-tipo') as HTMLSelectElement | null;
  const status = document.getElementById('contact-status');
  const submit = document.getElementById('contact-submit') as HTMLButtonElement | null;

  if (select) {
    const params = new URLSearchParams(window.location.search);
    const corso = params.get('corso');
    if (corso) {
      const match = Array.from(select.options).find((o) => o.value === corso);
      if (match) select.value = match.value;
    }
  }

  if (form && status && submit) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const payload = {
        nome: String(fd.get('nome') ?? ''),
        email: String(fd.get('email') ?? ''),
        problema: String(fd.get('problema') ?? ''),
        tipoRichiesta: String(fd.get('tipo') ?? ''),
        messaggio: String(fd.get('messaggio') ?? ''),
        website: String(fd.get('website') ?? ''),
      };

      submit.disabled = true;
      status.className = 'text-sm text-stone';
      status.textContent = 'Invio in corso…';

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.success) {
          status.className = 'text-sm text-midnight';
          status.textContent = 'Messaggio inviato. Ti rispondo entro 24 ore lavorative.';
          form.reset();
        } else {
          status.className = 'text-sm text-red-700';
          status.textContent =
            data.error ||
            'Qualcosa è andato storto. Riprova o scrivimi a info@stefanoandrello.me';
        }
      } catch {
        status.className = 'text-sm text-red-700';
        status.textContent =
          'Errore di rete. Riprova o scrivimi a info@stefanoandrello.me';
      } finally {
        submit.disabled = false;
      }
    });
  }
</script>
