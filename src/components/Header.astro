---
const links = [
  { href: '/chi-sono', label: 'Chi sono' },
  { href: '/percorso', label: 'Percorso' },
  { href: '/libri', label: 'Libri' },
  { href: '/blog', label: 'Blog' },
  { href: '/contatti', label: 'Contatti' },
];
---

<header class="sticky top-0 z-50 bg-cream border-b border-stone/20">
  <nav class="max-w-6xl mx-auto flex items-center justify-between px-6 py-5">
    <a
      href="/"
      class="font-heading font-semibold text-lg text-midnight tracking-tight"
    >
      Stefano Andrello
    </a>
    <div class="flex items-center">
      <ul class="hidden md:flex items-center gap-8 text-sm text-charcoal">
        <li>
          <a href="/glitch" class="manifesto-link" aria-label="Manifesto Glitch">
            <img
              src="/img/glitch/glitch-logo.png"
              alt=""
              height="28"
              class="inline-block h-5 md:h-7 w-auto mr-2 align-middle"
            />
            <span>MANIFESTO</span>
          </a>
        </li>
        {links.map(({ href, label }) => (
          <li>
            <a href={href} class="hover:text-midnight transition-colors">
              {label}
            </a>
          </li>
        ))}
      </ul>
      <span class="hidden md:inline-block w-px h-5 bg-stone/20 mx-3" aria-hidden="true"></span>
      <a
        href="https://atheneum.noscite.it/learn/login"
        target="_blank"
        rel="noopener"
        aria-label="Atheneum — Area Studenti"
        title="Atheneum — Area Studenti"
        class="hidden md:flex items-center text-stone hover:text-midnight transition-colors duration-200"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/>
          <path d="M22 10v6"/>
          <path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/>
        </svg>
      </a>
    </div>
  </nav>
</header>

<style>
  .manifesto-link {
    position: relative;
    display: inline-block;
    padding-left: 0.75rem;
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    font-weight: 700;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: #C724FF;
    text-decoration: none;
    transition: filter 0.15s ease;
  }

  .manifesto-link::before {
    content: '';
    position: absolute;
    left: 0;
    top: 10%;
    bottom: 10%;
    width: 2px;
    background: linear-gradient(180deg, #C724FF 0%, #00E5FF 100%);
  }

  .manifesto-link span {
    display: inline-block;
    transition: transform 0.12s ease, text-shadow 0.12s ease;
  }

  .manifesto-link:hover span {
    transform: skewX(-4deg);
    text-shadow: -1px 0 #C724FF, 1px 0 #00E5FF;
  }

  @media (prefers-reduced-motion: reduce) {
    .manifesto-link span { transition: none; }
    .manifesto-link:hover span { transform: none; text-shadow: none; }
  }
</style>
