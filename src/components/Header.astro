---
const links = [
  { href: '/chi-sono', label: 'Chi sono' },
  { href: '/libri', label: 'Libri' },
  { href: '/blog', label: 'Blog' },
  { href: '/contatti', label: 'Contatti' },
];
---

<header class="sticky top-0 z-50 bg-cream border-b border-stone/20">
  <nav class="max-w-6xl mx-auto flex items-center justify-between px-6 py-5">
    <a
      href="/"
      class="font-heading font-semibold text-lg text-midnight tracking-tight"
    >
      Stefano Andrello
    </a>

    <div class="flex items-center">
      <!-- Desktop nav -->
      <ul class="hidden md:flex items-center gap-8 text-sm text-charcoal">
        <li>
          <a href="/glitch" class="manifesto-link" aria-label="Manifesto Glitch">
            <img
              src="/img/glitch/glitch-logo.png"
              alt=""
              height="28"
              class="inline-block h-5 md:h-7 w-auto mr-2 align-middle"
            />
            <span>MANIFESTO</span>
          </a>
        </li>
        {links.map(({ href, label }) => (
          <li>
            <a href={href} class="hover:text-midnight transition-colors">
              {label}
            </a>
          </li>
        ))}
      </ul>
      <span class="hidden md:inline-block w-px h-5 bg-stone/20 mx-3" aria-hidden="true"></span>
      <a
        href="https://atheneum.noscite.it/learn/login"
        target="_blank"
        rel="noopener"
        aria-label="Atheneum — Area Studenti"
        title="Atheneum — Area Studenti"
        class="hidden md:flex items-center text-stone hover:text-midnight transition-colors duration-200"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/>
          <path d="M22 10v6"/>
          <path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/>
        </svg>
      </a>

      <!-- Hamburger button (mobile only) -->
      <button
        id="mobile-menu-toggle"
        type="button"
        aria-label="Apri menu"
        aria-expanded="false"
        aria-controls="mobile-menu-panel"
        class="md:hidden text-midnight hover:text-charcoal transition-colors duration-200"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="4" x2="20" y1="6" y2="6"/>
          <line x1="4" x2="20" y1="12" y2="12"/>
          <line x1="4" x2="20" y1="18" y2="18"/>
        </svg>
      </button>
    </div>
  </nav>
</header>

<!-- Mobile menu panel (overlay fullscreen, mobile only) -->
<div
  id="mobile-menu-panel"
  role="dialog"
  aria-modal="true"
  aria-label="Menu di navigazione"
  aria-hidden="true"
  class="mobile-menu-panel md:hidden"
>
  <div class="flex items-center justify-between px-6 py-5 border-b border-stone/20">
    <a
      href="/"
      class="font-heading font-semibold text-lg text-midnight tracking-tight"
      data-mobile-link
    >
      Stefano Andrello
    </a>
    <button
      id="mobile-menu-close"
      type="button"
      aria-label="Chiudi menu"
      class="text-midnight hover:text-charcoal transition-colors duration-200"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" x2="6" y1="6" y2="18"/>
        <line x1="6" x2="18" y1="6" y2="18"/>
      </svg>
    </button>
  </div>

  <nav class="flex flex-col px-6 py-8" aria-label="Navigazione mobile">
    <a
      href="/glitch"
      class="manifesto-link-mobile py-4 inline-flex items-center"
      data-mobile-link
    >
      <img
        src="/img/glitch/glitch-logo.png"
        alt=""
        height="28"
        class="inline-block h-7 w-auto mr-3 align-middle"
      />
      <span>MANIFESTO</span>
    </a>
    {links.map(({ href, label }) => (
      <a
        href={href}
        class="py-4 font-heading text-3xl text-midnight hover:text-gold/80 transition-colors"
        data-mobile-link
      >
        {label}
      </a>
    ))}
    <span class="block w-full h-px bg-stone/20 my-6" aria-hidden="true"></span>
    <a
      href="https://atheneum.noscite.it/learn/login"
      target="_blank"
      rel="noopener"
      class="py-4 font-heading text-2xl text-stone hover:text-midnight transition-colors inline-flex items-center gap-3"
      data-mobile-link
    >
      <span aria-hidden="true">🎓</span>
      <span>Area Studenti</span>
    </a>
  </nav>
</div>

<style>
  .manifesto-link {
    position: relative;
    display: inline-block;
    padding-left: 0.75rem;
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    font-weight: 700;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: #C724FF;
    text-decoration: none;
    transition: filter 0.15s ease;
  }

  .manifesto-link::before {
    content: '';
    position: absolute;
    left: 0;
    top: 10%;
    bottom: 10%;
    width: 2px;
    background: linear-gradient(180deg, #C724FF 0%, #00E5FF 100%);
  }

  .manifesto-link span {
    display: inline-block;
    transition: transform 0.12s ease, text-shadow 0.12s ease;
  }

  .manifesto-link:hover span {
    transform: skewX(-4deg);
    text-shadow: -1px 0 #C724FF, 1px 0 #00E5FF;
  }

  /* Mobile menu panel */
  .mobile-menu-panel {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: var(--color-cream);
    transform: translateY(-100%);
    transition: transform 0.3s ease;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .mobile-menu-panel.is-open {
    transform: translateY(0);
  }

  /* Mobile MANIFESTO — magenta, JetBrains Mono, bordo gradient */
  .manifesto-link-mobile {
    position: relative;
    padding-left: 0.75rem;
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    font-weight: 700;
    font-size: 1.125rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: #C724FF;
    text-decoration: none;
  }

  .manifesto-link-mobile::before {
    content: '';
    position: absolute;
    left: 0;
    top: 25%;
    bottom: 25%;
    width: 2px;
    background: linear-gradient(180deg, #C724FF 0%, #00E5FF 100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .manifesto-link span { transition: none; }
    .manifesto-link:hover span { transform: none; text-shadow: none; }
    .mobile-menu-panel { transition: none; }
  }
</style>

<script>
  (function initMobileMenu() {
    const toggle = document.getElementById('mobile-menu-toggle');
    const closeBtn = document.getElementById('mobile-menu-close');
    const panel = document.getElementById('mobile-menu-panel');
    if (!toggle || !panel || !closeBtn) return;

    // Idempotency: prevent double-binding on view-transition reloads
    if (panel.dataset.menuInit === '1') return;
    panel.dataset.menuInit = '1';

    const focusableSelector = 'a[href], button:not([disabled])';
    let lastFocused: HTMLElement | null = null;

    function openMenu() {
      lastFocused = document.activeElement as HTMLElement;
      panel!.classList.add('is-open');
      panel!.setAttribute('aria-hidden', 'false');
      toggle!.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      const first = panel!.querySelector(focusableSelector) as HTMLElement | null;
      first?.focus();
    }

    function closeMenu() {
      panel!.classList.remove('is-open');
      panel!.setAttribute('aria-hidden', 'true');
      toggle!.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      lastFocused?.focus();
    }

    toggle.addEventListener('click', openMenu);
    closeBtn.addEventListener('click', closeMenu);

    // Click on any nav link inside the panel: close before navigation
    panel.querySelectorAll('[data-mobile-link]').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    // Click on panel background (cream area, not on interactive children): close
    panel.addEventListener('click', (e) => {
      if (e.target === panel) closeMenu();
    });

    // ESC closes the menu
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && panel.classList.contains('is-open')) {
        closeMenu();
      }
    });

    // Focus trap: keep Tab inside panel while open
    panel.addEventListener('keydown', (e) => {
      if (!panel.classList.contains('is-open')) return;
      if (e.key !== 'Tab') return;
      const focusable = Array.from(
        panel.querySelectorAll(focusableSelector)
      ) as HTMLElement[];
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      const active = document.activeElement;
      if (e.shiftKey && active === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && active === last) {
        e.preventDefault();
        first.focus();
      }
    });

    // Resize past md breakpoint while open: close cleanly
    const mq = window.matchMedia('(min-width: 768px)');
    mq.addEventListener('change', (ev) => {
      if (ev.matches && panel.classList.contains('is-open')) closeMenu();
    });
  })();
</script>
