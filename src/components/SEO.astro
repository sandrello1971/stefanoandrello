---
type SchemaType =
  | 'WebSite'
  | 'Person'
  | 'Article'
  | 'Course'
  | 'Organization'
  | 'FAQPage';

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  schemaType?: SchemaType;
  faq?: FaqItem[];
}

const {
  title,
  description,
  ogImage,
  schemaType = 'WebSite',
  faq,
} = Astro.props;

const siteUrl = 'https://stefanoandrello.me';
const canonical = new URL(Astro.url.pathname, siteUrl).toString();

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Noscite S.r.l.s.',
  url: siteUrl,
  taxID: '14209320960',
  vatID: 'IT14209320960',
  founder: {
    '@type': 'Person',
    name: 'Stefano Andrello',
    url: siteUrl,
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Corsico',
    addressRegion: 'MI',
    addressCountry: 'IT',
  },
};

const faqSchema = (items: FaqItem[]) => ({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
});

const baseSchema: Record<SchemaType, Record<string, unknown>> = {
  WebSite: {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: title,
    description,
    url: siteUrl,
  },
  Person: {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Person',
        '@id': `${siteUrl}#stefano`,
        name: 'Stefano Andrello',
        jobTitle: 'AI Strategist',
        url: siteUrl,
        birthPlace: {
          '@type': 'Place',
          name: 'Corsico',
          address: {
            '@type': 'PostalAddress',
            addressLocality: 'Corsico',
            addressRegion: 'MI',
            addressCountry: 'IT',
          },
        },
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Corsico',
          addressRegion: 'MI',
          addressCountry: 'IT',
        },
        alumniOf: {
          '@type': 'CollegeOrUniversity',
          name: 'Università degli Studi di Milano',
          department: {
            '@type': 'EducationalOrganization',
            name: "Scienze dell'Informazione",
          },
        },
        worksFor: {
          '@type': 'Organization',
          name: 'Noscite S.r.l.s.',
          url: siteUrl,
          taxID: '14209320960',
          vatID: 'IT14209320960',
          address: {
            '@type': 'PostalAddress',
            addressLocality: 'Corsico',
            addressRegion: 'MI',
            addressCountry: 'IT',
          },
        },
        sameAs: [
          'https://www.linkedin.com/in/sandrello/',
          'https://www.facebook.com/Stefano.Andrello.Noscite',
          'https://www.instagram.com/stefano_andrello/',
          'https://github.com/',
        ],
      },
      {
        '@type': 'Book',
        '@id': `${siteUrl}#book-ia-in-pratica`,
        name: "L'Intelligenza Artificiale in Pratica",
        alternativeHeadline: 'Guida critica per educatori e professionisti',
        author: { '@id': `${siteUrl}#stefano` },
        datePublished: '2025-12-04',
        inLanguage: 'it',
        numberOfPages: 206,
        url: 'https://www.amazon.it/dp/B0G58CYJ4V',
        identifier: {
          '@type': 'PropertyValue',
          propertyID: 'ASIN',
          value: 'B0G58CYJ4V',
        },
      },
      {
        '@type': 'Book',
        '@id': `${siteUrl}#book-futuro-non-scritto`,
        name: 'Il Futuro non è scritto',
        alternativeHeadline: "Memorie di un'Intelligenza Artificiale",
        author: { '@id': `${siteUrl}#stefano` },
        inLanguage: 'it',
        url: 'https://www.amazon.it/dp/B0F8K8367C',
        identifier: {
          '@type': 'PropertyValue',
          propertyID: 'ASIN',
          value: 'B0F8K8367C',
        },
      },
    ],
  },
  Article: {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    url: canonical,
    author: {
      '@type': 'Person',
      name: 'Stefano Andrello',
      url: siteUrl,
    },
  },
  Course: {
    '@context': 'https://schema.org',
    '@type': 'Course',
    name: title,
    description,
    url: canonical,
    provider: {
      '@type': 'Organization',
      name: 'Noscite S.r.l.s.',
      url: siteUrl,
    },
  },
  Organization: organizationSchema,
  FAQPage: faq
    ? faqSchema(faq)
    : {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: [],
      },
};

const schemas: Record<string, unknown>[] = [baseSchema[schemaType]];
if (faq && schemaType !== 'FAQPage') {
  schemas.push(faqSchema(faq));
}

const ogImageUrl = ogImage
  ? new URL(ogImage, siteUrl).toString()
  : undefined;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
{ogImageUrl && <meta property="og:image" content={ogImageUrl} />}

<meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

{schemas.map((s) => (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(s)} />
))}
