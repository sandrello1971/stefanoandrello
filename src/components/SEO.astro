---
type SchemaType =
  | 'WebSite'
  | 'Person'
  | 'Article'
  | 'Course'
  | 'Organization'
  | 'FAQPage';

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  schemaType?: SchemaType;
  faq?: FaqItem[];
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage,
  schemaType = 'WebSite',
  faq,
  noindex = false,
} = Astro.props;

const siteUrl = 'https://stefanoandrello.me';
const canonical = new URL(Astro.url.pathname, siteUrl).toString();

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Noscite S.r.l.s.',
  url: siteUrl,
  taxID: '14209320960',
  vatID: 'IT14209320960',
  founder: {
    '@type': 'Person',
    name: 'Stefano Andrello',
    url: siteUrl,
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Corsico',
    addressRegion: 'MI',
    addressCountry: 'IT',
  },
};

const faqSchema = (items: FaqItem[]) => ({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
});

const baseSchema: Record<SchemaType, Record<string, unknown>> = {
  WebSite: {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: title,
    description,
    url: siteUrl,
    inLanguage: 'it-IT',
    author: {
      '@type': 'Person',
      name: 'Stefano Andrello',
      url: `${siteUrl}/chi-sono`,
    },
  },
  Person: {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Person',
        '@id': `${siteUrl}#stefano`,
        name: 'Stefano Andrello',
        jobTitle: ['Consulente AI', 'Formatore AI', 'AI Strategist'],
        description:
          "Consulente e formatore in intelligenza artificiale per PMI italiane. Affianca le direzioni aziendali nell'integrazione dell'AI con metodo human-in-the-loop, progetta formazione conforme all'Art. 4 dell'EU AI Act, sviluppa agenti AI e MCP server. Autore di tre libri sull'AI antropocentrica.",
        hasOccupation: {
          '@type': 'Occupation',
          name: 'Consulente e formatore in intelligenza artificiale',
          occupationLocation: { '@type': 'Country', name: 'Italia' },
        },
        knowsAbout: [
          'Consulenza in intelligenza artificiale per PMI',
          'Formazione aziendale sull\'intelligenza artificiale',
          'EU AI Act (Regolamento UE 2024/1689)',
          'AI Literacy obbligatoria (Art. 4)',
          'Governance e policy d\'uso dell\'AI in azienda',
          'AI agentica e agenti AI per processi aziendali',
          'Model Context Protocol (MCP)',
          'Human-in-the-loop e produttività governata',
          'AI antropocentrica',
        ],
        knowsLanguage: ['it', 'en'],
        url: siteUrl,
        birthPlace: {
          '@type': 'Place',
          name: 'Corsico',
          address: {
            '@type': 'PostalAddress',
            addressLocality: 'Corsico',
            addressRegion: 'MI',
            addressCountry: 'IT',
          },
        },
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Corsico',
          addressRegion: 'MI',
          addressCountry: 'IT',
        },
        alumniOf: {
          '@type': 'CollegeOrUniversity',
          name: 'Università degli Studi di Milano',
          department: {
            '@type': 'EducationalOrganization',
            name: "Scienze dell'Informazione",
          },
        },
        worksFor: {
          '@type': 'Organization',
          name: 'Noscite S.r.l.s.',
          url: siteUrl,
          taxID: '14209320960',
          vatID: 'IT14209320960',
          address: {
            '@type': 'PostalAddress',
            addressLocality: 'Corsico',
            addressRegion: 'MI',
            addressCountry: 'IT',
          },
        },
        sameAs: [
          'https://www.linkedin.com/in/stefanoandrello/',
          'https://www.facebook.com/Stefano.Andrello.Noscite',
          'https://www.instagram.com/stefano_andrello/',
        ],
        owns: [
          {
            '@type': 'EducationalOrganization',
            '@id': 'https://atheneum.noscite.it#atheneum',
            name: 'Atheneum Noscite',
            url: 'https://atheneum.noscite.it',
            description:
              'Piattaforma formativa di Noscite per la formazione AI delle PMI italiane, conforme EU AI Act.',
          },
        ],
      },
      {
        '@type': 'Book',
        '@id': `${siteUrl}#book-ia-in-pratica`,
        name: "L'Intelligenza Artificiale in Pratica",
        alternativeHeadline: 'Guida critica per educatori e professionisti',
        author: { '@id': `${siteUrl}#stefano` },
        datePublished: '2025-12-04',
        inLanguage: 'it',
        numberOfPages: 206,
        url: 'https://www.amazon.it/dp/B0G58CYJ4V',
        identifier: {
          '@type': 'PropertyValue',
          propertyID: 'ASIN',
          value: 'B0G58CYJ4V',
        },
      },
      {
        '@type': 'Book',
        '@id': `${siteUrl}#book-futuro-non-scritto`,
        name: 'Il Futuro non è scritto',
        alternativeHeadline: "Memorie di un'Intelligenza Artificiale",
        author: { '@id': `${siteUrl}#stefano` },
        inLanguage: 'it',
        url: 'https://www.amazon.it/dp/B0F8K8367C',
        identifier: {
          '@type': 'PropertyValue',
          propertyID: 'ASIN',
          value: 'B0F8K8367C',
        },
      },
      {
        '@type': 'Book',
        '@id': `${siteUrl}#book-restare-umani`,
        name: "Restare Umani: Guida all'intelligenza artificiale per chi non vuole smettere di pensare",
        alternativeHeadline: 'Manifesto antropocentrico sull\'intelligenza artificiale',
        author: { '@id': `${siteUrl}#stefano` },
        datePublished: '2026-04-28',
        inLanguage: 'it',
        numberOfPages: 199,
        isbn: '9798259248908',
        url: 'https://www.amazon.it/dp/B0GYX3JK3Z',
        identifier: [
          {
            '@type': 'PropertyValue',
            propertyID: 'ISBN',
            value: '9798259248908',
          },
          {
            '@type': 'PropertyValue',
            propertyID: 'ASIN',
            value: 'B0GYX3JK3Z',
          },
        ],
      },
    ],
  },
  Article: {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    url: canonical,
    author: {
      '@type': 'Person',
      name: 'Stefano Andrello',
      url: siteUrl,
    },
  },
  Course: {
    '@context': 'https://schema.org',
    '@type': 'Course',
    name: title,
    description,
    url: canonical,
    provider: {
      '@type': 'Organization',
      name: 'Noscite S.r.l.s.',
      url: siteUrl,
    },
  },
  Organization: organizationSchema,
  FAQPage: faq
    ? faqSchema(faq)
    : {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: [],
      },
};

const schemas: Record<string, unknown>[] = [baseSchema[schemaType]];
if (faq && schemaType !== 'FAQPage') {
  schemas.push(faqSchema(faq));
}

// Default OG image: editorial PNG generato da /og-image.png al build time.
// Sovrascrivibile per pagina passando la prop `ogImage` esplicita.
const ogImageUrl = new URL(ogImage ?? '/og-image.png', siteUrl).toString();
const ogImageAlt = 'Stefano Andrello — AI Strategist per PMI italiane';
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex,nofollow" />}

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="it_IT" />
<meta property="og:site_name" content="Stefano Andrello" />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:image:type" content="image/png" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={ogImageAlt} />

{schemas.map((s) => (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(s)} />
))}
