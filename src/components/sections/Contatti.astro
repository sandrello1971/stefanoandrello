---
import Container from '../Container.astro';
---

<section id="contatti" class="py-24 scroll-mt-24">
  <Container>
    <h2 class="text-4xl md:text-5xl font-heading font-semibold text-midnight leading-tight">
      Parliamo del tuo progetto.
    </h2>
    <p class="mt-6 text-lg text-stone max-w-2xl leading-relaxed">
      I canali diretti. Per richieste strutturate, apri il form completo.
    </p>

    <dl class="mt-12 grid grid-cols-1 md:grid-cols-4 gap-8 text-charcoal">
      <div>
        <dt class="text-xs uppercase tracking-widest text-stone font-medium">Email</dt>
        <dd class="mt-2">
          <a href="mailto:info@stefanoandrello.me" class="text-midnight hover:text-gold/80 transition-colors">
            info@stefanoandrello.me
          </a>
        </dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-widest text-stone font-medium">Telefono</dt>
        <dd class="mt-2">
          <a href="tel:+393476859801" class="text-midnight hover:text-gold/80 transition-colors">
            +39 347 685 9801
          </a>
        </dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-widest text-stone font-medium">WhatsApp</dt>
        <dd class="mt-2">
          <a
            href="https://wa.me/393476859801"
            target="_blank"
            rel="noopener noreferrer"
            class="text-midnight hover:text-gold/80 transition-colors"
          >
            wa.me/393476859801 &rarr;
          </a>
        </dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-widest text-stone font-medium">LinkedIn</dt>
        <dd class="mt-2">
          <a
            href="https://www.linkedin.com/in/stefanoandrello/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-midnight hover:text-gold/80 transition-colors"
          >
            /in/stefanoandrello &rarr;
          </a>
        </dd>
      </div>
    </dl>

    <div class="mt-12">
      <a
        href="/contatti"
        class="inline-flex items-center justify-center bg-gold text-midnight rounded-full px-8 py-3 font-medium hover:scale-[1.02] hover:bg-gold/90 transition-all"
      >
        Form completo &rarr;
      </a>
    </div>
  </Container>
</section>
