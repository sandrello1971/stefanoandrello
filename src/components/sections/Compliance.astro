---
import Container from '../Container.astro';

interface Row {
  corso: string;
  ore: string;
  ruolo: string;
  ct: string;
  ca: string;
  pc: string;
  cn: string;
}

const rows: Row[] = [
  { corso: 'PRIMUS', ore: '4h', ruolo: 'Awareness', ct: '◎', ca: '◑', pc: '◑', cn: '–' },
  { corso: 'CONSILIUM', ore: '7h', ruolo: 'Governance direzionale', ct: '◑', ca: '✓', pc: '✓', cn: '✓' },
  { corso: 'INITIUM', ore: '20h + esame', ruolo: 'Compliance primaria', ct: '✓', ca: '✓', pc: '✓', cn: '✓' },
  { corso: 'STRUCTURA', ore: '24h', ruolo: 'Governance documentale', ct: '✓', ca: '✓', pc: '◑', cn: '✓' },
  { corso: 'AI AGENTS & MCP', ore: '9h', ruolo: 'Sistemi agentici', ct: '✓', ca: '✓', pc: '✓', cn: '✓' },
];
---

<section class="py-24 bg-midnight text-cream">
  <Container>
    <h2 class="text-4xl md:text-5xl font-heading font-semibold leading-tight max-w-3xl">
      Corsi allineati all&apos;Art. 4 del Regolamento UE 2024/1689.
    </h2>
    <p class="mt-6 text-lg text-cream/80 max-w-2xl leading-relaxed">
      L&apos;AI Literacy dei dipendenti non &egrave; pi&ugrave; una scelta. Ecco come i corsi del portfolio coprono le quattro aree richieste.
    </p>

    <div class="mt-12 overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-cream/20 text-xs uppercase tracking-widest text-cream/70">
            <th class="py-4 pr-4 font-medium">Corso</th>
            <th class="py-4 px-4 font-medium">Ore</th>
            <th class="py-4 px-4 font-medium">Ruolo Art. 4</th>
            <th class="py-4 px-4 font-medium">CT <span class="hidden md:inline text-cream/50 normal-case tracking-normal">(Comprensione Tecnologica)</span></th>
            <th class="py-4 px-4 font-medium">CA <span class="hidden md:inline text-cream/50 normal-case tracking-normal">(Conoscenza Applicativa)</span></th>
            <th class="py-4 px-4 font-medium">PC <span class="hidden md:inline text-cream/50 normal-case tracking-normal">(Pensiero Critico)</span></th>
            <th class="py-4 px-4 font-medium">CN <span class="hidden md:inline text-cream/50 normal-case tracking-normal">(Conformit&agrave; Normativa)</span></th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr class="border-b border-cream/10">
              <td class="py-5 pr-4 font-heading text-lg whitespace-nowrap">{r.corso}</td>
              <td class="py-5 px-4 text-cream/80 whitespace-nowrap">{r.ore}</td>
              <td class="py-5 px-4 text-cream/80 text-sm">{r.ruolo}</td>
              <td class="py-5 px-4 text-xl" aria-label="Comprensione Tecnologica">{r.ct}</td>
              <td class="py-5 px-4 text-xl" aria-label="Conoscenza Applicativa">{r.ca}</td>
              <td class="py-5 px-4 text-xl" aria-label="Pensiero Critico">{r.pc}</td>
              <td class="py-5 px-4 text-xl" aria-label="Conformit&agrave; Normativa">{r.cn}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="mt-8 text-xs italic text-cream/60">
      &#10003; Piena &middot; &#9681; Parziale &middot; &#9678; Infrastrutturale &middot; &ndash; Non applicabile
    </p>
    <p class="mt-3 text-sm text-cream/80 max-w-3xl">
      PRIMUS &egrave; un workshop di awareness e da solo non &egrave; sufficiente a soddisfare l&apos;Art. 4. La compliance primaria &egrave; garantita da INITIUM.
    </p>
  </Container>
</section>
