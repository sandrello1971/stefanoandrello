---
import Container from '../Container.astro';
import { faqs } from '../../data/faq';
---

<section class="py-24">
  <Container>
    <h2 class="text-4xl md:text-5xl font-heading font-semibold text-midnight leading-tight">
      Domande frequenti.
    </h2>

    <div class="mt-12 border-t border-stone/20">
      {faqs.map((item) => (
        <details class="group border-b border-stone/20 py-6">
          <summary class="flex items-start justify-between gap-6 cursor-pointer list-none">
            <span class="text-lg md:text-xl font-heading font-semibold text-midnight leading-snug">
              {item.question}
            </span>
            <span
              class="flex-shrink-0 mt-1 text-2xl text-stone transition-transform group-open:rotate-45"
              aria-hidden="true"
            >
              +
            </span>
          </summary>
          <p class="mt-5 text-charcoal leading-relaxed max-w-3xl">
            {item.answer}
          </p>
        </details>
      ))}
    </div>
  </Container>
</section>
