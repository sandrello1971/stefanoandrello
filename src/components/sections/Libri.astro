---
import Container from '../Container.astro';

const libri = [
  {
    titolo: 'L’Intelligenza Artificiale in Pratica',
    sottotitolo: 'Guida critica per educatori e professionisti',
    img: '/img/libri/ia-in-pratica.jpg',
    alt: 'Copertina di L\'Intelligenza Artificiale in Pratica, di Stefano Andrello',
  },
  {
    titolo: 'Il Futuro non è scritto',
    sottotitolo: 'Memorie di un’Intelligenza Artificiale',
    img: '/img/libri/futuro-non-scritto.jpg',
    alt: 'Copertina di Il Futuro non è scritto, di Stefano Andrello',
  },
];
---

<section class="py-24 bg-sand">
  <Container>
    <h2 class="text-4xl md:text-5xl font-heading font-semibold text-midnight leading-tight">
      Due libri per capire l&apos;AI.
    </h2>

    <div class="mt-16 grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16">
      {libri.map((libro) => (
        <div class="flex flex-col items-start">
          <img
            src={libro.img}
            alt={libro.alt}
            width="320"
            height="480"
            loading="lazy"
            class="rounded-lg shadow-xl w-full max-w-[260px] mx-auto md:mx-0"
          />
          <h3 class="mt-8 text-2xl md:text-3xl font-heading font-semibold text-midnight leading-tight">
            {libro.titolo}
          </h3>
          <p class="mt-2 italic text-stone">
            {libro.sottotitolo}
          </p>
        </div>
      ))}
    </div>

    <div class="mt-14 flex justify-center">
      <a
        href="/libri"
        class="inline-flex items-center justify-center bg-gold text-midnight rounded-full px-8 py-3 font-medium hover:scale-[1.02] hover:bg-gold/90 transition-all"
      >
        Vai alla libreria &rarr;
      </a>
    </div>
  </Container>
</section>
