---
import Container from '../Container.astro';

const cases = [
  {
    situation: 'Non so ancora se mi serve',
    cta: 'Inizia da PRIMUS',
    corso: 'primus',
  },
  {
    situation: 'So che mi serve, ma non so dove agire',
    cta: 'Valuta con CONSILIUM',
    corso: 'consilium',
  },
  {
    situation: 'Devo mettere in regola il team',
    cta: 'Parliamo di INITIUM',
    corso: 'initium',
  },
];
---

<section class="py-32 bg-midnight text-cream">
  <Container>
    <h2 class="text-4xl md:text-5xl font-heading font-semibold leading-tight text-center max-w-3xl mx-auto">
      Il prossimo passo dipende da dove ti trovi ora.
    </h2>

    <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-12">
      {cases.map((c) => (
        <div class="flex flex-col items-start">
          <p class="text-lg text-cream/90 leading-relaxed min-h-[3.5rem]">
            &laquo;{c.situation}&raquo;
          </p>
          <a
            href={`/contatti?corso=${c.corso}`}
            class="mt-6 inline-flex items-center justify-center bg-gold text-midnight rounded-full px-6 py-3 font-medium hover:scale-[1.02] hover:bg-gold/90 transition-all"
          >
            {c.cta} &rarr;
          </a>
        </div>
      ))}
    </div>
  </Container>
</section>
